{
  "name": "@harness/agent",
  "version": "0.0.1",
  "description": "Harness — personal agent (daemon, TUI, CLI, memory)",
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "bin": {
    "harness": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "prestart": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@harness/core": "workspace:*",
    "@mariozechner/pi-ai": "^0.70.2",
    "@resvg/resvg-js": "^2.6.2",
    "@sinclair/typebox": "^0.34.49",
    "@tobilu/qmd": "^2.5.3",
    "@types/turndown": "^5.0.6",
    "baileys": "7.0.0-rc13",
    "chalk": "^5.6.2",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "imapflow": "^1.6.6",
    "ink": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "14.1.4",
    "marked-terminal": "^7.3.0",
    "node-pty": "^1.0.0",
    "pdfjs-dist": "^5.6.205",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "satori": "^0.26.0",
    "sharp": "0.35.3",
    "turndown": "^7.2.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
