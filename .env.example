# OpenAI / Azure / Anthropic / etc.
# Configure whichever provider(s) you use via pi-ai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_API_KEY=...

# Optional: custom base URLs
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (text / chat provider)
# OPENROUTER_API_KEY=sk-or-v1-...
# OpenRouter dedicated key for image/vision workloads (optional, used when image generation is configured)
# OPENROUTER_IMAGE_API_KEY=sk-or-v1-...

# ─── WhatsApp Gateway ───
# Whitelist: JSON map of phone number → display name.
# Numbers are normalized to digits-only (+, spaces, hyphens ignored).
# Messages from all other senders are silently dropped (logged, never answered).
WHATSAPP_WHITELIST={"4915112345678":"Philipp"}
# Legacy: single whitelist number (used only if WHATSAPP_WHITELIST is not set).
# WHATSAPP_WHITELIST_NUMBER=4915112345678
# Optional: AssemblyAI API key for voice message transcription.
# If absent, voice notes get a "transcription unavailable" annotation + file path.
# ASSEMBLYAI_API_KEY=...
