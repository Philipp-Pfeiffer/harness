# OpenAI / Azure / Anthropic / etc.
# Configure whichever provider(s) you use via pi-ai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_API_KEY=...

# Optional: custom base URLs
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── WhatsApp Gateway ───
# Whitelisted phone number (international format, no +). Messages from all
# other senders are silently dropped (logged, never answered).
WHATSAPP_WHITELIST_NUMBER=4915112345678
# Optional: AssemblyAI API key for voice message transcription.
# If absent, voice notes get a "transcription unavailable" annotation + file path.
# ASSEMBLYAI_API_KEY=...
